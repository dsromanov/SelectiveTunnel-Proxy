<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.selectivetunnel.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Application Support/SelectiveTunnel/bin/selectivetunnel-daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/Library/Application Support/SelectiveTunnel</string>
	<key>StandardOutPath</key>
	<string>/Library/Logs/SelectiveTunnel/daemon.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/SelectiveTunnel/daemon.err.log</string>
</dict>
</plist>
